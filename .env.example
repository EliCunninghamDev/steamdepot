# Live-test configuration. Copy to `.env` and export before running
# `scripts/test-live.sh`.
#
# Live tests are ignored by default (`cargo test` never touches the network).
# `scripts/test-live.sh` sources this file and runs them.

# App used by the anonymous live tests. The default is the Team Fortress 2
# dedicated server app, whose depots are publicly downloadable without a
# license. Apps with licensed depots will fail the download-plan test.
STEAMDEPOT_TEST_APP_ID=232250

# Optional: authenticated live tests. Leave empty to skip them.
STEAMDEPOT_USERNAME=
STEAMDEPOT_REFRESH_TOKEN=
